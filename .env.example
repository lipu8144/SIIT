# ═══════════════════════════════════════════════════════════
# SIIT — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env for local dev. In production (Vercel), add these
# under Settings → Environment Variables, then redeploy.
# The app runs in DEMO MODE (in-browser data) when Supabase is blank.

# ── Supabase (REQUIRED for production / real data) ────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Student login (User ID → hidden email) ───────────────
# Students sign in with a User ID, not an email. Supabase needs an email
# internally, so "siit-2024-001" becomes "siitsurada+siit-2024-001@gmail.com".
# MUST be identical to the LOGIN_EMAIL_BASE secret of the admin-users function.
# Use any real Gmail address (it never receives mail). Do not change it later,
# or existing logins stop working.
VITE_LOGIN_EMAIL_BASE="siitsurada@gmail.com"

# ── Contact details (shown in footer + contact page) ──────
VITE_CONTACT_PHONE="(+91) 7873987123"
VITE_CONTACT_EMAIL="siitsurada@gmail.com"
VITE_CONTACT_ADDRESS="Main Road, Sorada, Ganjam, Odisha"
VITE_WHATSAPP_NUMBER="917873987123"
# Google Maps → Share → Embed a map → copy the src="" URL
VITE_MAP_EMBED_URL=""

# ── Social links (leave blank to hide the icon) ───────────
VITE_SOCIAL_FACEBOOK=""
VITE_SOCIAL_INSTAGRAM="https://instagram.com/oscit_siit_surada"
VITE_SOCIAL_YOUTUBE=""
VITE_SOCIAL_TWITTER=""

# ── EmailJS (optional — contact form email notifications) ──
# Without these, the contact form still saves the enquiry as a lead.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# ── Firebase (optional — Google sign-in via Firebase) ─────
# Prefer Supabase Google OAuth instead (no extra package needed).
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""

# ── Google Analytics (optional) ───────────────────────────
VITE_GA4_MEASUREMENT_ID=""
